// SOCLab - Password spray from a single IP
// MITRE: T1110.003 | one IP failing against many distinct accounts in 30 min
SOCLabAuth_CL
| where TimeGenerated > ago(1h)
| where EventType == "SignIn" and Result == "Failure"
| summarize TargetedUsers = dcount(UserPrincipalName),
            Attempts = count(),
            SampleUsers = make_set(UserPrincipalName, 20),
            FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated)
    by SourceIP, Country, bin(TimeGenerated, 30m)
| where TargetedUsers >= 8
| project-away TimeGenerated
